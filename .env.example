# ---------------------------------------------------------------------------
# VentureOS environment. Copy this file to `.env.local` and fill in values.
# The app runs fully offline with none of these set (mock agent + fallback
# embeddings), but production features require the keys below.
# ---------------------------------------------------------------------------

# Postgres with the pgvector extension (Neon recommended).
# Required for real data. Example:
# postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/ventureos?sslmode=require
DATABASE_URL=

# Auth.js (NextAuth v5). Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — enables Google login + live Gmail/Calendar integrations.
# Configure at https://console.cloud.google.com (add Gmail + Calendar scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — enables full multi-step LLM reasoning + real embeddings.
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tavily — enables live web search for the Competitive Analysis copilot.
TAVILY_API_KEY=

# Inngest — durable background agent runs + recurring workflows.
# Local dev works with the Inngest dev server without these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
